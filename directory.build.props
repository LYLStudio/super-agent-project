<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>SuperAgent</RootNamespace>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="agile/**" />
    <None Include="docs/**" />
  </ItemGroup>
</Project>